    {
      "parameters": {
        "jsCode": "const request = $('Webhook').item.json.body;\nconst tickets = $input.all().map(item => item.json);\n\nconst similarTicket = tickets.find(ticket =>\n  ticket.property_id === request.property_id &&\n  ticket.category === request.category &&\n  ['open', 'in_progress'].includes(ticket.status)\n);\n\nreturn [{\n  json: {\n    similar_ticket_exists: !!similarTicket,\n    existing_ticket: similarTicket || null,\n    request\n  }\n}];"
      },
