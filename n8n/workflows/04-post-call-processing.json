              "value": "={{ $('Receive Post-call Event').item.json.body.conversation_id }}"
            },
            {
              "name": "X-Event-ID",
              "value": "={{ String($('Receive Post-call Event').item.json.body.event_id).slice(0, 89) + ':post-call' }}"
            }
          ]
