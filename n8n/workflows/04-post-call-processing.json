        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const body = $('Receive Post-call Event').item.json.body; return { conversation_id: body.conversation_id, ...(body.customer_id ? { customer_id: body.customer_id } : {}), intent: body.intent, summary: body.summary, ...(body.ticket_id ? { ticket_id: body.ticket_id } : {}), transfer_attempted: body.transfer_attempted, transfer_success: body.transfer_success, follow_up_required: body.follow_up_required }; })() }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 5000
